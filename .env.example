# Open AI - Codex API Sync
CHATGPT_ENTERPRISE_API_URL=https://chatgpt.com/backend-api/accounts/<ACCOUNT_ID>/spend-controls/current-user/monthly-usage?supports_usage_limit_modes=true
CHATGPT_ENTERPRISE_COOKIE=
CHATGPT_ENTERPRISE_AUTHORIZATION=
CHATGPT_ENTERPRISE_ACTIVE=

# Cursor API Sync (via Browser Cookie)
CURSOR_API_URL=https://cursor.com/api/usage-summary?teamId=<TEAM_ID>
CURSOR_COOKIE=
CURSOR_ACTIVE=

# Claude.ai API Sync
CLAUDE_API_URL=https://claude.ai/api/organizations/<ORGANIZATION_ID>/usage/spend
CLAUDE_COOKIE=
CLAUDE_MONTHLY_BUDGET_USD=1000
CLAUDE_ACTIVE=

# Buildkite Elasticsearch Agent Cost Sync
BUILDKITE_ES_URL=
BUILDKITE_ES_API_KEY=
BUILDKITE_ES_INDEX=buildkite-builds*
BUILDKITE_REPO_NAME=git://github.com/<USERNAME>/<REPO>.git
BUILDKITE_ES_COST_FIELD=agentCostDiscounted
BUILDKITE_MONTHLY_BUDGET_USD=250
BUILDKITE_ACTIVE=
